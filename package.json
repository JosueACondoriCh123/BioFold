{
  "name": "biofold-3d",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:platform": "playwright test tests/e2e/platform.spec.ts tests/e2e/platformEnvironment.spec.ts",
    "test:e2e:lab": "playwright test tests/e2e/smoke.spec.ts tests/e2e/laboratorySession.spec.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:test": "supabase test db",
    "supabase:functions": "supabase functions serve biofold-chat --env-file supabase/functions/.env.local",
    "test:platform:serve": "vite build --config vite.platform-e2e.config.ts && vite preview --config vite.platform-e2e.config.ts",
    "test:unconfigured:serve": "vite build --config vite.platform-e2e.config.ts --mode unconfigured && vite preview --config vite.platform-e2e.config.ts --mode unconfigured",
    "test:lab:serve": "vite build --config vite.e2e.config.ts && vite preview --config vite.e2e.config.ts"
  },
  "dependencies": {
    "3dmol": "^2.5.3",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.541.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "supabase": "2.116.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}
