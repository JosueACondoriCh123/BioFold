# Copy to supabase/functions/.env.local for local-only development.
# Never commit real values and never prefix server secrets with VITE_.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_public_key
OPENROUTER_API_KEY=replace_with_server_only_key
OPENROUTER_MODEL=replace_with_a_structured_output_capable_model
OPENROUTER_SITE_URL=http://127.0.0.1:4173
BIOFOLD_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
