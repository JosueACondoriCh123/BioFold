# ==============================================================================
# BioFold 3D - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` and provide your project's public configuration.
# NOTE: Do not commit actual secrets to version control.
# QA does NOT use this file or .env.local. `pnpm test:e2e` builds isolated
# test-only outputs with a reserved .test auth host and HTTP interception.
# Leave configuration absent until real public values are available; no fake login.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (public, safe for browser exposure).
# Use the project's sb_publishable_... key. A legacy anon JWT is a different
# format accepted for compatibility. Never put sb_secret_... or service_role here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
